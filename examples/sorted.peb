# Order split fields, then reverse them with a slice.
let fruits = split("pear apple fig")
let ordered = sort(fruits)
print(join(ordered, ", "))
print(join(ordered[::-1], ", "))
print(sort([3, 1, 2])[::-1])
# Find values in a list: position or membership, using the same equality as ==.
let names = split("pear apple fig")
print(index_of(names, "apple"))
print(index_of(names, "kiwi"))
print(contains(names, "fig"))
print(contains(names, "kiwi"))
print(index_of([1.0, 2], 1))
